<base:WpfUiWindow x:Class="Claudestrap.UI.Elements.ContextMenu.AccountManagerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:base="clr-namespace:Claudestrap.UI.Elements.Base"
                  xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:converters="clr-namespace:Claudestrap.UI.Converters"
                  xmlns:viewmodels="clr-namespace:Claudestrap.UI.ViewModels"
                  d:DataContext="{d:DesignInstance Type=viewmodels:AccountManagerViewModel}"
                  mc:Ignorable="d"
                  Title="Accounts"
                  Width="720"
                  Height="640"
                  MinWidth="0"
                  MinHeight="0"
                  AllowsTransparency="True"
                  Background="Transparent"
                  ExtendsContentIntoTitleBar="True"
                  ResizeMode="NoResize"
                  WindowStyle="None"
                  WindowStartupLocation="CenterScreen"
                  TextOptions.TextFormattingMode="Display"
                  TextOptions.TextRenderingMode="ClearType"
                  FontFamily="Poppins, Inter, Segoe UI">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- ============ Palette (matches LaunchMenuDialog) ============ -->
        <SolidColorBrush x:Key="BackgroundBase"   po:Freeze="True" Color="#0F1015" />
        <SolidColorBrush x:Key="SecondaryBg"      po:Freeze="True" Color="#171821" />
        <SolidColorBrush x:Key="CardBg"           po:Freeze="True" Color="#14151E" />
        <SolidColorBrush x:Key="TextPrimary"      po:Freeze="True" Color="#ECEBF5" />
        <SolidColorBrush x:Key="TextSecondary"    po:Freeze="True" Color="#C2C2D6" />
        <SolidColorBrush x:Key="TextDescription"  po:Freeze="True" Color="#6C6C82" />
        <SolidColorBrush x:Key="IconColor"        po:Freeze="True" Color="#7C7D93" />
        <SolidColorBrush x:Key="IconHover"        po:Freeze="True" Color="#C9C9DF" />
        <SolidColorBrush x:Key="LineColor"        po:Freeze="True" Color="#262837" />
        <SolidColorBrush x:Key="ButtonBase"       po:Freeze="True" Color="#4A3FC4" />
        <SolidColorBrush x:Key="ButtonText"       po:Freeze="True" Color="#F2F1FB" />
        <SolidColorBrush x:Key="ButtonHover"      po:Freeze="True" Color="#5D50E6" />
        <SolidColorBrush x:Key="BorderSubtle"     po:Freeze="True" Color="#1E6C63F0" />
        <SolidColorBrush x:Key="DangerBase"       po:Freeze="True" Color="#5A2E2E" />
        <SolidColorBrush x:Key="DangerHover"      po:Freeze="True" Color="#743939" />
        <SolidColorBrush x:Key="DangerText"       po:Freeze="True" Color="#E7B8B8" />

        <!-- ============ Background glow (was a tiled dot pattern) ============ -->
        <RadialGradientBrush x:Key="BackgroundGlow" po:Freeze="True"
                              Center="0.82,0.05" GradientOrigin="0.82,0.05"
                              RadiusX="0.85" RadiusY="1.05">
            <GradientStop Offset="0"    Color="#3D6C63F0" />
            <GradientStop Offset="0.55" Color="#146C63F0" />
            <GradientStop Offset="1"    Color="#006C63F0" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" po:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#7A6FF5" />
            <GradientStop Offset="1" Color="#5B4FE0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonGradientHover" po:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#8B80FF" />
            <GradientStop Offset="1" Color="#6C5FF0" />
        </LinearGradientBrush>

        <!-- ============ Titlebar icon button ============ -->
        <Style x:Key="TitleIconStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource IconColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource IconHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Pill button base (shared property defaults; each derived
             style below supplies its own full ControlTemplate) ============ -->
        <Style x:Key="PillButtonBase" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryPillStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource ButtonText}" />
            <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonGradientHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryPillStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource TextDescription}" />
            <Setter Property="Background" Value="{StaticResource SecondaryBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="Bd" Property="Background" Value="#1D1F2B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallPrimaryPillStyle" TargetType="Button" BasedOn="{StaticResource PrimaryPillStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SmallDangerPillStyle" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DangerText}" />
            <Setter Property="Background" Value="{StaticResource DangerBase}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource BackgroundBase}"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">

        <Grid MouseDown="Header_MouseDown" Background="Transparent">
            <Border Background="{StaticResource BackgroundGlow}" CornerRadius="12" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- =============== TOP BAR =============== -->
                <Grid Grid.Row="0" Background="Transparent">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                                Orientation="Horizontal" Margin="14,0,0,0">
                        <Image Width="16" Height="16"
                               Source="pack://application:,,,/Claudestrap.ico"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Stretch="Uniform" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="Accounts" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Style="{StaticResource TitleIconStyle}" Click="Minimize_Click">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource TitleIconStyle}" Margin="14,0,0,0" Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- =============== BODY =============== -->
                <Grid Grid.Row="1" Margin="20,4,20,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Login / add-cookie row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryPillStyle}"
                                Content="Login"
                                ToolTip="Sign in through Roblox's own login page (username/password, passkey, 2FA -- whatever it asks for)"
                                Command="{Binding LoginCommand, Mode=OneTime}" />
                        <ui:TextBox Width="300" Height="34" Margin="10,0,0,0"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="Or paste a .ROBLOSECURITY cookie"
                                    Text="{Binding CookieInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource SecondaryPillStyle}"
                                Content="Add via Cookie"
                                Margin="8,0,0,0"
                                Command="{Binding AddCookieCommand, Mode=OneTime}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="2,16,0,8"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDescription}"
                               Text="SAVED ACCOUNTS" />

                    <!-- Account list -->
                    <Grid Grid.Row="2">
                        <TextBlock Text="No accounts added yet. Sign in or paste a cookie above."
                                   FontSize="12"
                                   Foreground="{StaticResource TextDescription}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="2,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                BorderBrush="{StaticResource LineColor}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding LastUsedDisplay}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{StaticResource TextDescription}" />
                                                </StackPanel>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallPrimaryPillStyle}"
                                                            Content="Launch"
                                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                            Command="{Binding DataContext.LaunchAccountCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SmallDangerPillStyle}"
                                                            Content="Remove"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RemoveAccountCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Advanced: legacy cookie-file backups -->
                    <ui:CardExpander Grid.Row="3" Margin="0,10,0,0" IsExpanded="False">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}" Text="Advanced: cookie file backups" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextDescription}"
                                           Text="Snapshot/restore the single active RobloxCookies.dat file. Superseded by Saved Accounts above for most uses." />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0" DataContext="{Binding Backups}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="220" Height="32" VerticalContentAlignment="Center"
                                         Text="{Binding NewBackupLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Optional label for your backup" />
                                <ui:Button Content="Create Backup" Icon="Save24" Appearance="Primary" Margin="8,0,0,0"
                                           Command="{Binding CreateBackupCommand}" />
                                <ui:Button Content="Refresh" Icon="ArrowClockwise24" Margin="8,0,0,0" Appearance="Secondary"
                                           Command="{Binding RefreshCommand}" />
                                <ui:Button Content="Logout" Icon="SignOut24" Margin="8,0,0,0" Appearance="Danger"
                                           Command="{Binding LogoutCommand}"
                                           ToolTip="Delete the active Roblox cookie and log out" />
                                <ui:Button Content="Backup Folder" Icon="Folder24" Margin="8,0,0,0" Appearance="Secondary"
                                           Command="{Binding OpenBackupsFolderCommand}" />
                            </StackPanel>

                            <ListView MaxHeight="180" ItemsSource="{Binding Backups}"
                                      SelectedItem="{Binding Selected, Mode=TwoWay}" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10" Margin="0,4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <DockPanel>
                                                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding CreatedUtc, StringFormat=Created: {0:g}}" FontSize="11" Opacity="0.7" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                    <ui:Button Content="Switch" Icon="ArrowSwap24" Margin="6,0,0,0" Appearance="Primary"
                                                               Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="Delete" Icon="Delete24" Margin="6,0,0,0" Appearance="Danger"
                                                               Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ui:CardExpander>
                </Grid>

                <!-- =============== STATUS BAR =============== -->
                <Grid Grid.Row="2" Margin="20,0,20,14">
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextDescription}"
                               HorizontalAlignment="Left" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding LastUsedAccountDisplay}" FontSize="11" Foreground="{StaticResource TextDescription}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDescription}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Multi: Off" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MultiInstanceLaunching}" Value="True">
                                            <Setter Property="Text" Value="Multi: On" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>
