<base:WpfUiWindow x:Class="Claudestrap.UI.Elements.ContextMenu.RPCWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:Claudestrap.UI.Elements.ContextMenu"
                  xmlns:base="clr-namespace:Claudestrap.UI.Elements.Base"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:models="clr-namespace:Claudestrap.UI.ViewModels.ContextMenu"
                  mc:Ignorable="d"
                  MinWidth="580"
                  MinHeight="480"
                  Width="720"
                  Height="520"
                  Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                  ExtendsContentIntoTitleBar="True"
                  WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Gradient background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}"/>
                <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}"/>
                <GradientStop Offset="1.1" Color="{DynamicResource WindowBackgroundColorThird}"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Padding="10"
                     Title="Discord RPC Customizer"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     Icon="pack://application:,,,/Claudestrap.ico"/>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" Margin="12" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2">
                <TextBlock Text="Rich Presence Settings" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Configure your Discord Presence below." Margin="0,2,0,10"/>

                <!-- General -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Application ID" FontWeight="SemiBold"/>
                        <TextBlock Text="Deine Discord-App-ID (discord.com/developers). Leer = Claudestrap-Standard."
                                   FontSize="11" Foreground="Gray" Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <ui:TextBox Text="{Binding ApplicationId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="1005469189907173486"/>

                        <TextBlock Text="App Name" Margin="0,10,0,0"/>
                        <ui:TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Details" Margin="0,10,0,0"/>
                        <ui:TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="State" Margin="0,10,0,0"/>
                        <ui:TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Claudestrap RPC Settings -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Claudestrap Game-RPC Einstellungen" FontWeight="SemiBold"/>
                        <TextBlock Text="Diese Einstellungen gelten für die automatische Spiel-RPC, nicht für die manuelle RPC oben."
                                   FontSize="11" Foreground="Gray" Margin="0,2,0,8" TextWrapping="Wrap"/>

                        <CheckBox Content="Spielzeit anzeigen (Timestamp)" IsChecked="{Binding RpcShowTimestamp}" Margin="0,4,0,0"/>
                        <CheckBox Content="&quot;Game Page&quot;-Button anzeigen" IsChecked="{Binding RpcShowGamePageButton}" Margin="0,6,0,0"/>
                        <CheckBox Content="&quot;Join Server&quot;-Button anzeigen" IsChecked="{Binding RpcShowJoinButton}" Margin="0,6,0,0"/>

                        <TextBlock Text="'Join Server' Button-Label" Margin="0,10,0,2"/>
                        <ui:TextBox Text="{Binding RpcJoinButtonLabel, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Join server"/>

                        <TextBlock Text="'Game Page' Button-Label" Margin="0,8,0,2"/>
                        <ui:TextBox Text="{Binding RpcGamePageButtonLabel, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Game Page"/>

                        <TextBlock Text="Großes Bild — eigener Text (leer = Spielname)" Margin="0,8,0,2"/>
                        <ui:TextBox Text="{Binding RpcCustomLargeImageText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="z.B. Claudestrap by Snipez &amp; DEERSTUDIO"/>

                        <TextBlock Text="Kleines Bild — eigener Text (leer = Accountname)" Margin="0,8,0,2"/>
                        <ui:TextBox Text="{Binding RpcCustomSmallImageText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="z.B. Powered by Claudestrap"/>

                        <ui:Button Content="Speichern" Appearance="Primary" Click="SaveRpcSettings_Click"
                                   Margin="0,12,0,0" Icon="Save24"/>
                    </StackPanel>
                </ui:Card>

                <!-- Images (Custom RPC) -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Bilder — Manuelle RPC (keys from Developer Portal)" FontWeight="SemiBold"/>
                        <TextBlock Text="Large Image Key" Margin="0,6,0,0"/>
                        <ui:TextBox Text="{Binding LargeImageKey, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Small Image Key" Margin="0,10,0,0"/>
                        <ui:TextBox Text="{Binding SmallImageKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Buttons (Custom RPC) -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Buttons — Manuelle RPC (bis zu 2)" FontWeight="SemiBold"/>

                        <!-- Button 1 -->
                        <CheckBox Content="Button 1 aktivieren" IsChecked="{Binding Button1Enabled}"/>
                        <TextBlock Text="Label" Margin="0,6,0,0"/>
                        <ui:TextBox Text="{Binding Button1Label, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="URL" Margin="0,6,0,0"/>
                        <ui:TextBox Text="{Binding Button1Url, UpdateSourceTrigger=PropertyChanged}"/>

                        <Separator Margin="0,10,0,10"/>

                        <!-- Button 2 -->
                        <CheckBox Content="Button 2 aktivieren" IsChecked="{Binding Button2Enabled}"/>
                        <TextBlock Text="Label" Margin="0,6,0,0"/>
                        <ui:TextBox Text="{Binding Button2Label, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="URL" Margin="0,6,0,0"/>
                        <ui:TextBox Text="{Binding Button2Url, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox Content="Auto Start RPC" Grid.Column="1"
                             Margin="12,0,0,0"
          IsChecked="{Binding AutoStartRpc, Mode=TwoWay}" />


            <!-- Control buttons -->
            <ui:Button Grid.Column="2" Margin="12,0,0,0" Appearance="Primary"
                       Content="Start / Update RPC" Command="{Binding StartRpcCommand}"/>
            <ui:Button Grid.Column="3" Margin="8,0,0,0" Appearance="Danger"
                       Content="Stop RPC" Command="{Binding StopRpcCommand}"/>
            <ui:Button Grid.Column="4" Margin="8,0,0,0" Appearance="Secondary"
                       Content="Close" Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</base:WpfUiWindow>
