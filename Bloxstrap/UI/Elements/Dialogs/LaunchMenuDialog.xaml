<base:WpfUiWindow
    x:Class="Claudestrap.UI.Elements.Dialogs.LaunchMenuDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Claudestrap.UI.Elements.Base"
    xmlns:converters="clr-namespace:Claudestrap.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Claudestrap.UI.Elements.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Claudestrap.UI.ViewModels"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:resources="clr-namespace:Claudestrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Claudestrap"
    Width="600"
    Height="340"
    MinWidth="0"
    MinHeight="0"
    AllowsTransparency="True"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    FontFamily="Poppins, Inter, Segoe UI"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- ============ Palette (cool indigo-tinted dark, was flat gray) ============ -->
        <SolidColorBrush x:Key="WindowBg"         po:Freeze="True" Color="#0B0C11" />
        <SolidColorBrush x:Key="BackgroundBase"   po:Freeze="True" Color="#0F1015" />
        <SolidColorBrush x:Key="SecondaryBg"      po:Freeze="True" Color="#171821" />
        <SolidColorBrush x:Key="GridColor"        po:Freeze="True" Color="#1E202B" />
        <SolidColorBrush x:Key="TextPrimary"      po:Freeze="True" Color="#ECEBF5" />
        <SolidColorBrush x:Key="TextSecondary"    po:Freeze="True" Color="#C2C2D6" />
        <SolidColorBrush x:Key="TextDescription"  po:Freeze="True" Color="#6C6C82" />
        <SolidColorBrush x:Key="IconColor"        po:Freeze="True" Color="#7C7D93" />
        <SolidColorBrush x:Key="IconHover"        po:Freeze="True" Color="#C9C9DF" />
        <SolidColorBrush x:Key="LineColor"        po:Freeze="True" Color="#262837" />
        <SolidColorBrush x:Key="OrText"           po:Freeze="True" Color="#54556B" />
        <SolidColorBrush x:Key="ButtonBase"       po:Freeze="True" Color="#4A3FC4" />
        <SolidColorBrush x:Key="ButtonText"       po:Freeze="True" Color="#F2F1FB" />
        <SolidColorBrush x:Key="ButtonHover"      po:Freeze="True" Color="#5D50E6" />
        <SolidColorBrush x:Key="BorderSubtle"     po:Freeze="True" Color="#1E6C63F0" />
        <SolidColorBrush x:Key="ButtonTextHover"  po:Freeze="True" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HighlightBg"      po:Freeze="True" Color="#1D1F2B" />
        <SolidColorBrush x:Key="SelectedBg"       po:Freeze="True" Color="#262837" />

        <SolidColorBrush x:Key="VersionBg"        po:Freeze="True" Color="#2C2D49" />
        <SolidColorBrush x:Key="VersionText"      po:Freeze="True" Color="#DBDBF2" />
        <SolidColorBrush x:Key="CommitBg"         po:Freeze="True" Color="#181927" />
        <SolidColorBrush x:Key="CommitText"       po:Freeze="True" Color="#6E6F87" />

        <!-- ============ Background glow (was a tiled dot pattern) : a soft violet
             spotlight fading in from the top-right, on the same Border/CornerRadius
             the dots used to occupy so it stays flush with the shell's rounded edge ============ -->
        <RadialGradientBrush x:Key="BackgroundGlow" po:Freeze="True"
                              Center="0.82,0.05" GradientOrigin="0.82,0.05"
                              RadiusX="0.85" RadiusY="1.05">
            <GradientStop Offset="0"    Color="#3D6C63F0" />
            <GradientStop Offset="0.55" Color="#146C63F0" />
            <GradientStop Offset="1"    Color="#006C63F0" />
        </RadialGradientBrush>

        <!-- ============ Button Gradient ============ -->
        <LinearGradientBrush x:Key="ButtonGradient" po:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#7A6FF5" />
            <GradientStop Offset="1" Color="#5B4FE0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonGradientHover" po:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#8B80FF" />
            <GradientStop Offset="1" Color="#6C5FF0" />
        </LinearGradientBrush>

        <!-- ============ Pill Button (Launch Roblox) ============ -->
        <Style x:Key="LaunchPillStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ButtonText}" />
            <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="19"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6"
                                                      Direction="270" Opacity="0.45"
                                                      Color="#5B4FE0" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonGradientHover}" />
                                <Setter Property="Foreground" Value="{StaticResource ButtonTextHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonBase}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Titlebar icon button (Settings/Min/Close) ============ -->
        <Style x:Key="TitleIconStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource IconColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource IconHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Secondary action pill (Settings/Studio/Website) ============ -->
        <Style x:Key="SecondaryActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDescription}" />
            <Setter Property="Background" Value="{StaticResource SecondaryBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Badges ============ -->
        <Style x:Key="VersionBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VersionBg}" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="CommitBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CommitBg}" />
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- ============ Account dropdown (bottom right) ============ -->
        <Style x:Key="AccountComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HighlightBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource VersionText}" />
            <Setter Property="Background" Value="{StaticResource VersionBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccountComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="11"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource VersionText}" />
                                                <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="9"
                                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource VersionText}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="Fade" StaysOpen="False">
                                <Border Background="{StaticResource SecondaryBg}"
                                        BorderBrush="{StaticResource LineColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="150"
                                        MaxHeight="220"
                                        Margin="0,4,0,0"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Window shell : rounded 12px, indigo-tinted near-black base + a soft glow overlay flush to the rounded edge -->
    <Border Background="{StaticResource BackgroundBase}"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">

        <Grid Background="Transparent">
            <!-- Glow overlay lives on a Border with the same CornerRadius as the shell,
                 so its rounded edge sits exactly on top of the shell's — no visible seam. -->
            <Border Background="{StaticResource BackgroundGlow}"
                    CornerRadius="12"
                    IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- =============== TOP BAR (edge-to-edge) =============== -->
                <Grid Grid.Row="0" Background="Transparent" MouseDown="Header_MouseDown">
                    <!-- Left group : icon (14,12) + title @ 8px gap -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                                Orientation="Horizontal" Margin="14,0,0,0">
                        <Image Width="16" Height="16"
                               Source="pack://application:,,,/Claudestrap.ico"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Stretch="Uniform" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="Claudestrap" />
                    </StackPanel>

                    <!-- Right group : Settings / Minimize / Close -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Style="{StaticResource TitleIconStyle}"
                                Command="{Binding LaunchSettingsCommand, Mode=OneTime}"
                                Margin="0,0,0,0">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource TitleIconStyle}" Margin="14,0,0,0" Click="Minimize_Click">
                            <ui:SymbolIcon Symbol="Subtract24" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource TitleIconStyle}" Margin="14,0,0,0" Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- =============== CENTER =============== -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               Text="Ready to launch" />

                    <TextBlock Margin="0,10,0,0"
                               Width="320"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="Regular"
                               LineHeight="18"
                               Foreground="{StaticResource TextDescription}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="Head to Roblox.com and join a game to get started" />

                    <!-- OR divider : 70px | OR | 70px -->
                    <Grid Margin="0,22,0,22" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource LineColor}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="10,0" FontSize="10" FontWeight="Medium"
                                   Foreground="{StaticResource OrText}" Text="OR" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource LineColor}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Launch pill -->
                    <Button Style="{StaticResource LaunchPillStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding LaunchRobloxCommand, Mode=OneTime}"
                            IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBooleanConverter}}"
                            TabIndex="0">
                        <Grid>
                            <TextBlock Text="Launch Roblox" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
                                <TextBlock Margin="6,0,0,0" Text="Launching..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Secondary actions : Studio / Clean / About -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryActionStyle}"
                                Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}"
                                Content="Studio" />
                        <Button Style="{StaticResource SecondaryActionStyle}" Margin="8,0,0,0"
                                Command="{Binding CleanTracesCommand, Mode=OneTime}"
                                Content="Clean" />
                        <Button Style="{StaticResource SecondaryActionStyle}" Margin="8,0,0,0"
                                Command="{Binding LaunchAboutCommand, Mode=OneTime}"
                                Content="{x:Static resources:Strings.About_Title}" />
                    </StackPanel>
                </StackPanel>

                <!-- =============== BOTTOM ROW : version/commit badges (left) + accounts (right) =============== -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Border Style="{StaticResource VersionBadgeStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource VersionText}"
                                       Text="{Binding VersionShort, Mode=OneTime}" />
                        </Border>
                        <Border Style="{StaticResource CommitBadgeStyle}" Margin="6,0,0,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="9" FontWeight="Regular"
                                       Foreground="{StaticResource CommitText}"
                                       Text="{Binding RobloxVersionCommit, Mode=OneWay, FallbackValue=version-…}" />
                        </Border>
                    </StackPanel>

                    <ComboBox Style="{StaticResource AccountComboBoxStyle}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              ItemsSource="{Binding AccountOptions}"
                              SelectedItem="{Binding SelectedAccountOption, Mode=TwoWay}"
                              IsSynchronizedWithCurrentItem="False"
                              IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBooleanConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />

                                    <!-- Relogin: only shown once a background check finds the saved cookie no longer authenticates -->
                                    <Button Grid.Column="1"
                                            Width="20" Height="20"
                                            Margin="0,0,2,0"
                                            Command="{Binding DataContext.RelinkAccountCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Logged out — click to sign in again">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TitleIconStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoggedOut}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="11"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>

                                    <!-- Delete: hidden on the trailing "+ Add Account" row -->
                                    <Button Grid.Column="2"
                                            Width="20" Height="20"
                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove account">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TitleIconStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAddAccountOption}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="11"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>
