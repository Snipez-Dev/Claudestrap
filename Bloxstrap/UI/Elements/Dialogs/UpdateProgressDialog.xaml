<base:WpfUiWindow
    x:Class="Claudestrap.UI.Elements.Dialogs.UpdateProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Claudestrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Claudestrap"
    Width="440"
    MinWidth="0"
    MinHeight="0"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}"/>
                <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}"/>
                <GradientStop Offset="1.05" Color="{DynamicResource WindowBackgroundColorThird}"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Claudestrap"
            Grid.Row="0"
            Padding="8"
            CanMaximize="False"
            Foreground="White"
            Icon="pack://application:,,,/Claudestrap.ico"
            KeyboardNavigation.TabNavigation="None"
            ShowClose="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Updating Claudestrap" />

            <TextBlock
                x:Name="VersionText"
                Margin="0,2,0,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="" />

            <TextBlock
                x:Name="StatusText"
                Margin="0,16,0,6"
                FontSize="14"
                Text="Preparing..."
                TextWrapping="Wrap" />

            <ProgressBar
                x:Name="Progress"
                Height="6"
                Maximum="100"
                Minimum="0"
                Value="0" />

            <Grid Margin="0,6,0,0">
                <TextBlock
                    x:Name="SizeText"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="" />
                <TextBlock
                    x:Name="PercentText"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="" />
            </Grid>

            <TextBlock
                Margin="0,14,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="Claudestrap restarts on its own once the update is installed."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
