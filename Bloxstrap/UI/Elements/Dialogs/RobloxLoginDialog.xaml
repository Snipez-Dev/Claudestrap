<base:WpfUiWindow
    x:Class="Claudestrap.UI.Elements.Dialogs.RobloxLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Claudestrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="Sign in to Roblox"
    Width="480"
    Height="640"
    MinWidth="0"
    MinHeight="0"
    AllowsTransparency="True"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    FontFamily="Poppins, Inter, Segoe UI"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBase"   po:Freeze="True" Color="#0F1015" />
        <SolidColorBrush x:Key="TextPrimary"      po:Freeze="True" Color="#ECEBF5" />
        <SolidColorBrush x:Key="TextDescription"  po:Freeze="True" Color="#6C6C82" />
        <SolidColorBrush x:Key="IconColor"        po:Freeze="True" Color="#7C7D93" />
        <SolidColorBrush x:Key="IconHover"        po:Freeze="True" Color="#C9C9DF" />
        <SolidColorBrush x:Key="BorderSubtle"     po:Freeze="True" Color="#1E6C63F0" />

        <Style x:Key="TitleIconStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource IconColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource IconHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBase}"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">
        <Grid MouseDown="Header_MouseDown" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                            Orientation="Horizontal" Margin="14,0,0,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Sign in to Roblox" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource TitleIconStyle}" Click="Minimize_Click">
                        <ui:SymbolIcon Symbol="Subtract24" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource TitleIconStyle}" Margin="14,0,0,0" Click="Close_Click">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="1,0,1,1">
                <Border CornerRadius="0,0,11,11" ClipToBounds="True">
                    <wv2:WebView2 x:Name="LoginWebView"
                                  Visibility="Collapsed"
                                  NavigationCompleted="LoginWebView_NavigationCompleted" />
                </Border>

                <Grid x:Name="LoadingOverlay" Background="{StaticResource BackgroundBase}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" />
                        <TextBlock x:Name="LoadingText"
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDescription}"
                                   Text="Loading sign-in..." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</base:WpfUiWindow>
