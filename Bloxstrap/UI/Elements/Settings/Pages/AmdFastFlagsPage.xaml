<ui:UiPage
    x:Class="Claudestrap.UI.Elements.Settings.Pages.AmdFastFlagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Claudestrap.UI.Elements.Controls"
    xmlns:settings="clr-namespace:Claudestrap.UI.ViewModels.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:Claudestrap.UI.ViewModels"
    Title="AMD Graphics Settings"
    Scrollable="True">

    <StackPanel Margin="0,0,14,14">

        <TextBlock
            FontSize="14"
            Margin="0,0,0,4"
            TextWrapping="Wrap"
            Text="Configure AMD Radeon driver settings via the Windows Registry (HKLM UMD key)." />

        <TextBlock
            FontSize="12"
            Foreground="{StaticResource TextFillColorTertiaryBrush}"
            Margin="0,0,0,8"
            TextWrapping="Wrap"
            Text="{Binding AdapterName}" />

        <!-- Adapter not found warning -->
        <ui:InfoBar
            IsOpen="{Binding HasAdapter, Converter={StaticResource InverseBoolConverter}}"
            Title="No AMD Adapter Detected"
            Message="No AMD/Radeon graphics adapter was found on this system. Settings cannot be applied."
            Severity="Warning"
            IsClosable="False"
            Margin="0,0,0,8"/>

        <StackPanel IsEnabled="{Binding HasAdapter}">

            <!-- Apply / Reset buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button
                    Content="Apply Settings"
                    Icon="CheckmarkCircle24"
                    Appearance="Primary"
                    Click="Apply_Click"
                    Margin="0,0,8,0"/>
                <ui:Button
                    Content="Reset to Driver Defaults"
                    Icon="ArrowReset24"
                    Appearance="Secondary"
                    Click="Reset_Click"/>
            </StackPanel>

            <TextBlock
                Margin="0,4,0,8"
                FontSize="12"
                Foreground="{StaticResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="Note: Changes require administrator rights. Roblox must be restarted after applying." />

            <!-- Anti-Aliasing -->
            <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Anti-Aliasing" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   Text="Smooths jagged edges on 3D geometry." />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:OptionControl
                        Header="Anti-Aliasing Mode"
                        Description="How Radeon applies AA — override application settings or enhance them.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding AntiAliasingModes}"
                            SelectedItem="{Binding SelectedAntiAliasingMode}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Anti-Aliasing Level"
                        Description="Number of AA samples. Higher = smoother edges, lower performance.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding AntiAliasingLevels}"
                            SelectedItem="{Binding SelectedAntiAliasingLevel}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Morphological Anti-Aliasing (MLAA)"
                        Description="AMD's post-process AA. Smooths edges with minimal performance cost.">
                        <ui:ToggleSwitch IsChecked="{Binding EnableMorphologicalAA}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

            <!-- Texture Filtering -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Texture Filtering" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   Text="Controls texture quality and anisotropic filtering." />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:OptionControl
                        Header="Texture Filtering Quality"
                        Description="Performance = fastest, High Quality = sharpest textures at distance.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding TextureQualityModes}"
                            SelectedItem="{Binding SelectedTextureQuality}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Anisotropic Filtering Mode"
                        Description="Enable the driver to apply AF regardless of application settings.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding AnisotropicModes}"
                            SelectedItem="{Binding SelectedAnisotropicMode}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Anisotropic Filtering Level"
                        Description="16x gives the sharpest textures at oblique angles.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding AnisotropicLevels}"
                            SelectedItem="{Binding SelectedAnisotropicLevel}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Surface Format Optimization"
                        Description="Allows the driver to use a more efficient surface format. Recommended: On.">
                        <ui:ToggleSwitch IsChecked="{Binding EnableSurfaceFormatOptimization}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

            <!-- Performance -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Performance &amp; Sync" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   Text="VSync, frame rate limiting, and tessellation." />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:OptionControl
                        Header="Vertical Sync (VSync)"
                        Description="Synchronizes frame output with monitor refresh to prevent screen tearing.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding VSyncModes}"
                            SelectedItem="{Binding SelectedVSync}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Frame Rate Target Control (FRTC)"
                        Description="Driver-level FPS limiter. Reduces power consumption and heat.">
                        <ui:ToggleSwitch IsChecked="{Binding EnableFRTC}" />
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="FRTC Target FPS"
                        Description="{Binding FrtcLabel}">
                        <StackPanel Width="260">
                            <Slider
                                Minimum="10"
                                Maximum="300"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding EnableFRTC}"
                                Value="{Binding FRTCTarget, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding FrtcLabel}" />
                        </StackPanel>
                    </controls:OptionControl>

                    <controls:OptionControl
                        Header="Tessellation"
                        Description="Controls hardware tessellation level for games that use it.">
                        <ComboBox
                            Width="260"
                            ItemsSource="{Binding TessellationModes}"
                            SelectedItem="{Binding SelectedTessellationMode}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>

        </StackPanel>
    </StackPanel>
</ui:UiPage>
